# Second participant path: record one keeps the burst order but its id is set
# to 0x22 so the player comparison at info->1C fails and gPlayerEntities answers
# instead. The switch then runs with a non-zero stats pointer and writes
# 0x02/0x06/0x0A/0x0E, while the player-slot counters stay 0.
other_player_type1 drain:1:0:0 in_other=1 other_id=0x22 in_id=34 | ot_a=1 st_a=0
