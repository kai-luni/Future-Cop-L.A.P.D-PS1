# fcop-env-golden/v1 - environment / matrix render cores (tests/host/env_test.sh)
#
# Every expected value below is hand-derived from the source of the unit under
# test (src/game/<ADDR>.c); the derivation is written next to each case. No
# second implementation was run to produce them. Numbers: signed decimal or 0x hex
# (32-bit). SENT = 0x5A5A5A5A is the harness pre-fill for words that must stay
# untouched (as s16 that is 23130, as a byte 0x5A = 90).
#
# Sine table D_8009A234 (u16, read from SLUS_007.39 at file offset 0x8AA34):
#   T[0]=0 T[1]=50 T[0x100]=12540 T[0x200]=23170 T[0x300]=30274 T[0x3FF]=32768 T[0x400]=32768
#   T[0x155]=16369 T[0x2AB]=28386
# gSinCos: a&=0xFFF, i=a&0x3FF, s=T[i]<<1, c=T[0x400-i]<<1, quadrant a>>10:
#   0:(s,c) 1:(c,-s) 2:(-s,-c) 3:(-c,s)
# => sin/cos used below: 0x100 (25080,60548)  0x200 (46340,46340)
#    0x300 (60548,25080)  0xF00 (-25080,60548)

# ---------------------------------------------------------------- func_8001846C gSinCos
# SINCOS angle sin cos
SINCOS 0x000      0      65536   # i=0: s=0, c=T[0x400]*2
SINCOS 0x100  25080      60548   # s=12540*2, c=T[0x300]*2
SINCOS 0x200  46340      46340   # s=c=23170*2
SINCOS 0x155  32738      56772   # s=16369*2, c=T[0x2AB]*2=28386*2
SINCOS 0x400  65536          0   # q1, i=0: (c,-s)=(65536,-0)
SINCOS 0x500  60548     -25080   # q1, i=0x100: (c,-s)
SINCOS 0x800      0     -65536   # q2, i=0: (-s,-c)
SINCOS 0xB00 -60548     -25080   # q2, i=0x300: s=60548 c=25080 -> (-s,-c)
SINCOS 0xC00 -65536          0   # q3, i=0: (-c,s)
SINCOS 0xF00 -25080      60548   # q3, i=0x300: (-c,s)=(-25080,60548)
SINCOS 0x1100 25080      60548   # masked to 0x100
SINCOS 0xFFFFFFFF -100   65536   # masked 0xFFF, q3, i=0x3FF: s=T[0x3FF]*2=65536, c=T[1]*2=100 -> (-c,s)

# ---------------------------------------------------------------- func_800188D0 gBuildRotationMatrix
# ROT x y z m0..m8   (harness also checks that words 9..11 keep SENT)
# all-zero branch: identity
ROT 0 0 0         65536 0 0  0 65536 0  0 0 65536
# z==0,y==0,x!=0: m4=0x10000, m0=m8=cx, m6=sx, m2=-sx, m1=m3=m5=m7=0
ROT 0x100 0 0     60548 0 -25080  0 65536 0  25080 0 60548
# z==0,y!=0,x==0: m0=0x10000, m8=m4=cy, m5=sy, m7=-sy, rest 0
ROT 0 0x100 0     65536 0 0  0 60548 25080  0 -25080 60548
# z!=0,y==0,x==0: m0=m4=cz, m8=0x10000, m1=sz, m3=-sz, rest 0
ROT 0 0 0x100     60548 25080 0  -25080 60548 0  0 0 65536
# z==0,y!=0,x!=0 (x=0x200,y=0x100): m0=cx=46340 m1=0 m2=-sx=-46340 m4=cy=60548 m7=-sy=-25080;
#   >>2: sy=6270 cy=15137 sx=11585 cx=11585
#   m3=(6270*11585)>>12=17733 m5=(6270*11585)>>12=17733 m6=(15137*11585)>>12=42813 m8=42813
ROT 0x200 0x100 0 46340 0 -46340  17733 60548 17733  42813 -25080 42813
# z!=0,y==0,x!=0 (x=0x200,z=0x100): m6=sx=46340 m7=0 m8=cx=46340 m1=sz=25080 m4=cz=60548;
#   >>2: sx=11585 sz=6270 cz=15137 cx=11585
#   m0=(15137*11585)>>12=42813  m2=(-(15137*11585))>>12=-42814
#   m3=(-(6270*11585))>>12=-17734  m5=(6270*11585)>>12=17733
ROT 0x200 0 0x100 42813 25080 -42814  -17734 60548 17733  46340 0 46340
# z!=0,y!=0,x==0 (y=0x200,z=0x100): m6=0 m0=cz=60548 m3=-sz=-25080 m7=-sy=-46340 m8=cy=46340;
#   >>2: sz=6270 cz=15137 cy=11585 sy=11585
#   m1=(6270*11585)>>12=17733 m2=17733 m4=(15137*11585)>>12=42813 m5=42813
ROT 0 0x200 0x100 60548 17733 17733  -25080 42813 42813  0 -46340 46340
# general (x=0x200,y=0x100,z=0x300): raw sy=25080; >>2: sz=15137 cz=6270 sy=6270 cy=15137 sx=11585 cx=11585
#   t=(15137*6270)>>14=5792  u=(6270*6270)>>14=2399
#   m0=(6270*11585+5792*11585)>>12=34115   m1=(15137*15137)>>12=55939
#   m2=(5792*11585-6270*11585)>>12=-1352    m3=(2399*11585-15137*11585)>>12=-36028
#   m4=(6270*15137)>>12=23171               m5=(15137*11585+2399*11585)>>12=49598
#   m6=(15137*11585)>>12=42813  m7=-25080   m8=(15137*11585)>>12=42813
ROT 0x200 0x100 0x300 34115 55939 -1352  -36028 23171 49598  42813 -25080 42813
# angle masking: x=0x1F00->0xF00, y=-0x100->0xF00, z=0x1000->0 => z==0,y!=0,x!=0
#   sx=sy=-25080 cx=cy=60548: m0=60548 m1=0 m2=25080 m4=60548 m7=25080
#   >>2: sy=-6270 cy=15137 sx=-6270 cx=15137
#   m3=(-6270*-6270)>>12=9597 m5=(-6270*15137)>>12=-23172 m6=(15137*-6270)>>12=-23172 m8=(15137*15137)>>12=55939
ROT 0x1F00 -0x100 0x1000  60548 0 25080  9597 60548 -23172  -23172 25080 55939

# ---------------------------------------------------------------- func_80018DC0 gBuildRotationMatrixVariant
# ROTV x y z m0..m8  (single-angle, identity and z==0,y,x branches are textually the same
# expressions as func_800188D0, so those expected rows are identical)
ROTV 0 0 0         65536 0 0  0 65536 0  0 0 65536
ROTV 0x100 0 0     60548 0 -25080  0 65536 0  25080 0 60548
ROTV 0 0x100 0     65536 0 0  0 60548 25080  0 -25080 60548
ROTV 0 0 0x100     60548 25080 0  -25080 60548 0  0 0 65536
ROTV 0x200 0x100 0 46340 0 -46340  17733 60548 17733  42813 -25080 42813
# z!=0,y==0,x!=0 (x=0x200,z=0x100): m3=-sz=-25080 m4=c=cz=60548 m2=-xs=-46340 m8=d=cx=46340 m5=0
#   a=cz>>2=15137 b=cx>>2=11585 sz>>2=6270 sx>>2=11585
#   m0=(15137*11585)>>12=42813 m1=(11585*6270)>>12=17733 m6=(15137*11585)>>12=42813 m7=(6270*11585)>>12=17733
ROTV 0x200 0 0x100 42813 17733 -46340  -25080 60548 0  42813 17733 46340
# z!=0,y!=0,x==0 (y=0x200,z=0x100): m0=cz=60548 m2=0 m1=sz=25080 m5=sy=46340 m8=cy=46340
#   >>2: sz=6270 cz=15137 sy=11585 cy=11585
#   m3=(-(11585*6270))>>12=-17734 m4=(11585*15137)>>12=42813 m6=(11585*6270)>>12=17733
#   m7=(-(15137*11585))>>12=-42814
ROTV 0 0x200 0x100 60548 25080 0  -17734 42813 46340  17733 -42814 46340
# general (x=0x200,y=0x100,z=0x300): p=sx=46340; >>2: sz=15137 cz=6270 sy=6270 cy=15137 sx=11585 cx=11585
#   m0=(6270*11585)>>12=17733  t=(6270*11585)>>14=4433  m1=(11585*15137)>>12=42813
#   m3=(6270*4433-15137*15137)>>12=-49154  m4=(15137*6270+15137*4433)>>12=39553
#   m5=(11585*6270)>>12=17733  u=(15137*11585)>>14=10703
#   m6=(6270*15137+10703*6270)>>12=39554  m7=(10703*15137-6270*6270)>>12=29955
#   m8=(15137*11585)>>12=42813  m2=-p=-46340
ROTV 0x200 0x100 0x300 17733 42813 -46340  -49154 39553 17733  39554 29955 42813
ROTV 0x1F00 -0x100 0x1000  60548 0 25080  9597 60548 -23172  -23172 25080 55939

# ---------------------------------------------------------------- func_80019470 gTransposeMatrix3x3
# TRANSPOSE s0..s8 d0..d8 ; d[r][c] = s[c][r]
TRANSPOSE 1 2 3 4 5 6 7 8 9                1 4 7 2 5 8 3 6 9
TRANSPOSE -1 0x7FFFFFFF 0x80000000 0 65536 -65536 42 -42 7   -1 0 42 0x7FFFFFFF 65536 -42 0x80000000 -65536 7

# ---------------------------------------------------------------- func_8001A81C gMulMatrixVector
# MULMV m0..m8 x y z o0 o1 o2 ; o0=x*m0+y*m3+z*m6, o1=x*m1+y*m4+z*m7, o2=x*m2+y*m5+z*m8,
# each product = middle 32 bits of the 64-bit mult = (hi<<16)|(lo>>16) = (prod>>16) mod 2^32
# identity 1.0 diagonal: products are exact
MULMV 65536 0 0 0 65536 0 0 0 65536   0x12345 -0x20000 7   0x12345 -0x20000 7
# m=[0x8000,0x10000,0x40000, 0x8000,-0x10000,0, 0,0x18000,0x10000], v=(3,-3,0x40000000)
#   o0 = (3*0x8000)>>16=1  + (-3*0x8000)>>16=-2 + 0                      = -1
#   o1 = (3*0x10000)>>16=3 + (-3*-0x10000)>>16=3 + (2^30*0x18000)>>16=0x60000000 = 0x60000006
#   o2 = (3*0x40000)>>16=12 + 0 + (2^30*0x10000)>>16=0x40000000          = 0x4000000C
MULMV 0x8000 0x10000 0x40000 0x8000 -0x10000 0 0 0x18000 0x10000   3 -3 0x40000000   -1 0x60000006 0x4000000C
# wrap: x*m0 = 2^30*2^18 = 2^48 -> hi=0x10000, lo=0 -> (hi<<16)|(lo>>16) = 0 (32-bit); z*m6 = 6
MULMV 0x40000 0 0 0 0 0 0x10000 0 0   0x40000000 5 6   6 0 0

# ---------------------------------------------------------------- func_80018860 gBuildViewMatrix
# VIEW r0..r8 t0 t1 t2  ->  out0..out8 = R^T (func_80019470), out9..11 = -(func_8001A81C(R^T, t))
# R = z-rotation 0x100, t=(0x10000,0x20000,-0x30000). M=R^T=[60548,-25080,0, 25080,60548,0, 0,0,65536]
#   o0 = 65536*60548>>16 + 131072*25080>>16 + 0 = 60548+50160 = 110708  -> -110708
#   o1 = 65536*-25080>>16 + 131072*60548>>16 + 0 = -25080+121096 = 96016 -> -96016
#   o2 = 0 + 0 + -196608*65536>>16 = -196608                              -> 196608
VIEW 60548 25080 0 -25080 60548 0 0 0 65536  0x10000 0x20000 -0x30000   60548 -25080 0 25080 60548 0 0 0 65536  -110708 -96016 196608
# R = 0.5*I, t=(1001,-1001,0x7FFF): 1001*0x8000>>16=500, -1001*0x8000>>16=floor(-500.5)=-501,
#   32767*0x8000>>16=16383  -> negated (-500, 501, -16383)
VIEW 0x8000 0 0 0 0x8000 0 0 0 0x8000  1001 -1001 0x7FFF   0x8000 0 0 0 0x8000 0 0 0 0x8000  -500 501 -16383

# ---------------------------------------------------------------- func_80010750 gGteLoadMatrix
# LOADMAT w0..w11 -> GTE ctrl0..7 (raw register words). From the retail words:
#   c0 = (w3<<12 & 0xFFFF0000) | (w0>>4 & 0xFFFF)      c1 = ((-w1)<<12 & hi) | (w6>>4 & 0xFFFF)
#   c2 = ((-w7)<<12 & hi) | ((-w4)>>4 & 0xFFFF)        c3 = (w5<<12 & hi) | (w2>>4 & 0xFFFF)
#   c4 = (w8>>4) & 0xFFFF   c5 = w9>>4   c6 = (-w10)>>4   c7 = w11>>4   (all sra)
# A = z-rot 0x100 + T(0x12345,0x1000,-0x20):
#   c0: hi -25080>>4=-1568=0xF9E0, lo 60548>>4=3784=0x0EC8          -> 0xF9E00EC8
#   c1: hi (-25080)>>4=0xF9E0, lo 0>>4                              -> 0xF9E00000
#   c2: hi -0>>4=0, lo (-60548)>>4=-3785=0xF137                      -> 0x0000F137
#   c3: 0   c4: 65536>>4=0x1000   c5: 0x1234   c6: -0x1000>>4=-0x100   c7: -0x20>>4=-2
LOADMAT 60548 25080 0 -25080 60548 0 0 0 65536 0x12345 0x1000 -0x20   0xF9E00EC8 0xF9E00000 0x0000F137 0 0x1000 0x1234 0xFFFFFF00 0xFFFFFFFE
# wrap/truncation: w0=0x7FFFF0 (lo 0x7FFFF&0xFFFF=0xFFFF), w3=0x123456 (<<12 -> 0x23456000 -> hi 0x2345)
#   c1: -0x10<<12=0xFFFF0000, -0x80000>>4=0xFFFF8000&0xFFFF=0x8000      -> 0xFFFF8000
#   c2: -(1)<<12 -> hi 0xFFFF, -(-0x10)>>4=1                             -> 0xFFFF0001
#   c3: -0xF<<12=0xFFFF1000 -> hi 0xFFFF, 0xF>>4=0                       -> 0xFFFF0000
#   c4: 0x8000F>>4=0x8000   c5: -1>>4=-1   c6: -(0x80000010)=0x7FFFFFF0 sra4 = 0x07FFFFFF   c7: 0x07FFFFFF
#   (w10 may not be 0x80000000: the retail `neg` is a trapping `sub` -> integer overflow exception)
LOADMAT 0x7FFFF0 0x10 0xF 0x123456 -0x10 -0xF -0x80000 1 0x8000F -1 0x80000010 0x7FFFFFFF   0x2345FFFF 0xFFFF8000 0xFFFF0001 0xFFFF0000 0x8000 0xFFFFFFFF 0x07FFFFFF 0x07FFFFFF

# ---------------------------------------------------------------- func_80010820 gGteLoadRotation
# LOADROT w0..w8 -> ctrl0..7 ; same packing as func_80010750, ctrl5..7 forced to 0 (harness pre-fills SENT)
LOADROT 60548 25080 0 -25080 60548 0 0 0 65536   0xF9E00EC8 0xF9E00000 0x0000F137 0 0x1000 0 0 0
LOADROT 0x7FFFF0 0x10 0xF 0x123456 -0x10 -0xF -0x80000 1 0x8000F   0x2345FFFF 0xFFFF8000 0xFFFF0001 0xFFFF0000 0x8000 0 0 0

# ---------------------------------------------------------------- GTE batch transforms
# Rotation used below (loaded by the retail loader from A): RT = [[3784,-1568,0],[-1568,-3785,0],[0,0,4096]],
# TR (func_80010750 only) = (4660,-256,-2).
#
# func_8001006C: XF6C w0..w8 count  x0 y0 z0 x1 y1 z1  d0..d5   (RT via func_80010820, TR=0)
#   VXY0 = ((x<<12)>>>16) | ((y>>4)<<16), VZ0 = z>>4 (s16)  => V = (s16)(x>>4), (s16)(y>>4), (s16)(z>>4)
#   command 0x4A486012: sf=1 mx=0(RT) v=0(V0) cv=3(no TR) lm=0; store IR1<<4, (-IR2)<<4, IR3<<4
# v=(0x10000,0x20000,0x30000) -> V=(4096,8192,12288):
#   IR1=(3784*4096-1568*8192)>>12=648  IR2=(-1568*4096-3785*8192)>>12=-9138  IR3=12288
#   -> (10368, 146208, 196608)
# v=(-0x123,0x7FFF0,0x80000) -> V=(-19, 32767, (s16)0x8000=-32768):
#   IR1=(3784*-19-1568*32767)>>12=-12562  IR2=(-1568*-19-3785*32767)>>12=-30272  IR3=-32768
#   -> (-200992, 484352, -524288)
# v=(0x7FFF0,-0x80000,0) -> V=(32767,-32768,0): MAC1=(3784*32767+1568*32768)>>12=42815 -> IR1 sat 32767,
#   IR2=(-1568*32767+3785*32768)>>12=17736, IR3=0 -> (524272, -283776, 0)
XF6C 60548 25080 0 -25080 60548 0 0 0 65536  2  0x10000 0x20000 0x30000  -0x123 0x7FFF0 0x80000   10368 146208 196608  -200992 484352 -524288
XF6C 60548 25080 0 -25080 60548 0 0 0 65536  1  0x7FFF0 -0x80000 0  1 2 3   524272 -283776 0  0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A
XF6C 60548 25080 0 -25080 60548 0 0 0 65536  0  1 2 3 4 5 6   0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A
#
# func_8001010C: XF10C w0..w11 count  x0 y0 z0 x1 y1 z1  o0..o5   (8-byte s16 vertices, RT+TR via func_80010750)
#   command 0x4A486012: cv=3 -> TR NOT added; store sh IR1, sh -IR2, sh IR3 (pad half untouched)
# (4096,8192,12288): IR=(648,-9138,12288) -> (648, 9138, 12288)
# (32767,-32768,0): MAC1=42815 -> IR1 32767 ; IR2=17736 ; IR3=0 -> (32767, -17736, 0)
XF10C 60548 25080 0 -25080 60548 0 0 0 65536 0x12345 0x1000 -0x20  2  4096 8192 12288  32767 -32768 0   648 9138 12288  32767 -17736 0
XF10C 60548 25080 0 -25080 60548 0 0 0 65536 0x12345 0x1000 -0x20  1  4096 8192 12288  1 1 1   648 9138 12288  23130 23130 23130
#
# func_800101D4: XF1D4 same layout; command 0x4A480012: cv=0 -> MAC = (TR*4096 + RT*V0)>>12
# (4096,8192,12288): IR1=4660+648=5308  IR2=-256-9138=-9394  IR3=-2+12288=12286 -> (5308, 9394, 12286)
# (32767,-32768,0): MAC1=(4660*4096+3784*32767+1568*32768)>>12=47475 -> IR1 32767
#   MAC2=(-256*4096-1568*32767+3785*32768)>>12=17480 -> stored -17480 ; MAC3=(-2*4096)>>12=-2
XF1D4 60548 25080 0 -25080 60548 0 0 0 65536 0x12345 0x1000 -0x20  2  4096 8192 12288  32767 -32768 0   5308 9394 12286  32767 -17480 -2
XF1D4 60548 25080 0 -25080 60548 0 0 0 65536 0x12345 0x1000 -0x20  0  4096 8192 12288  1 1 1   23130 23130 23130  23130 23130 23130
#
# func_80010234: XF234 same layout, outputs 32-bit words (stride 0xC): MAC1<<4, (-MAC2)<<4, MAC3<<4 (no saturation)
# (4096,8192,12288): (5308*16, 9394*16, 12286*16) = (84928, 150304, 196576)
# (32767,-32768,0): (47475*16, -17480*16, -2*16) = (759600, -279680, -32)
XF234 60548 25080 0 -25080 60548 0 0 0 65536 0x12345 0x1000 -0x20  2  4096 8192 12288  32767 -32768 0   84928 150304 196576  759600 -279680 -32
XF234 60548 25080 0 -25080 60548 0 0 0 65536 0x12345 0x1000 -0x20  1  4096 8192 12288  1 1 1   84928 150304 196576  0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A

# ---------------------------------------------------------------- func_8001047C gProjectVertexBatch
# PROJ w0..w11 H OFX OFY wmode count  x0 y0 z0 x1 y1 z1   sxy0 sz0 sxy1 sz1 clip0 clip1 ret
# Matrix: 1.0 diagonal + T(0x100,0x200,0x8000) via func_80010750 -> RT=diag(4096,-4096,4096), TR=(16,-32,2048).
# H=512, OFX=160<<16, OFY=120<<16, DQA=DQB=0 (IR0=0, no bit 12). Width: wmode==1 -> 0x140 else 0xA0.
# Per vertex (retail words): if FLAG & 0x01C66000 -> clip=1 and SXY/SZ NOT stored;
#   else store SXY2,SZ3 and clip = (SZ3<0x400) | (slt(SXY2&0xFFFF, width)<<6) | (slt(SXY2>>>16, 0xF0)<<7)
#   (andi/srl zero-extend, so a negative SX never sets 0x40). Return = OR of all FLAG words.
# a=(100,50,0): MAC=(116,-82,2048), SZ3=2048, q=(512*65536+1024)/2048=16384
#   SX=(0xA00000+116*16384)>>16=189  SY=(0x780000-82*16384)>>16=99  -> SXY=0x006300BD
#   clip(w=0x140) = 0 | 0x40 | 0x80 = 0xC0 ; clip(w=0xA0) = 0x80
# b=(-1000,0,-1500): MAC=(-984,-32,548), SZ3=548, q=(512*65536+274)/548=61231
#   SX=(0xA00000-984*61231)>>16=-760 (0xFD08)  SY=(0x780000-32*61231)>>16=90 -> SXY=0x005AFD08
#   clip = 1 (SZ3<0x400) | 0 (0xFD08 !< width) | 0x80 = 0x81
# c=(0,0,-4000): MAC3=-1952 -> SZ3=0 bit18; H>=2*SZ3 -> q=0x1FFFF bit17; SX=191 SY=56 in range
#   FLAG=0x00060000|bit31 = 0x80060000 -> clip=1, nothing stored
# d=(4000,0,0): MAC1=4016, q=16384, SX=(0xA00000+4016*16384)>>16=1164 -> clamp 0x3FF bit14
#   FLAG=0x80004000 -> clip=1, nothing stored
PROJ 65536 0 0 0 65536 0 0 0 65536 0x100 0x200 0x8000  512 0xA00000 0x780000 1  2  100 50 0  -1000 0 -1500   0x006300BD 2048 0x005AFD08 548  0xC0 0x81 0
PROJ 65536 0 0 0 65536 0 0 0 65536 0x100 0x200 0x8000  512 0xA00000 0x780000 0  2  100 50 0  -1000 0 -1500   0x006300BD 2048 0x005AFD08 548  0x80 0x81 0
PROJ 65536 0 0 0 65536 0 0 0 65536 0x100 0x200 0x8000  512 0xA00000 0x780000 1  2  100 50 0  0 0 -4000       0x006300BD 2048 0x5A5A5A5A 0x5A5A5A5A  0xC0 1 0x80060000
PROJ 65536 0 0 0 65536 0 0 0 65536 0x100 0x200 0x8000  512 0xA00000 0x780000 1  1  4000 0 0  100 50 0        0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A  1 0x5A 0x80004000
PROJ 65536 0 0 0 65536 0 0 0 65536 0x100 0x200 0x8000  512 0xA00000 0x780000 1  0  100 50 0  100 50 0        0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A 0x5A5A5A5A  0x5A 0x5A 0

# ---------------------------------------------------------------- func_80013CB8 gComposeBoneMatrix
# COMPOSE parent0..11 flags offset x y z rx ry rz  slot1_0..11      (node arg0=1, parent = slot 0)
# Harness animation table: T = {0, 0, 0x100, 16, -16, 0x400, 0, 0}; a non-direct field f reads T[offset+(u16)f].
# Local matrix = func_80018DC0(rx,ry,rz) rows + (x,y,z)<<4; parent loaded by func_80010820; the 12 words are
# pushed through func_8001006C as 4 vertices (V=(s16)(w>>4)), then slot1.xyz += parent.xyz.
# Parent 1.0 diagonal -> RT=diag(4096,-4096,4096): IR=(VX,-VY,VZ), stored (VX<<4, VY<<4, VZ<<4) = (w>>4)<<4.
# C1: flags 0x3F (all direct), rx=0x100 -> rows [60548,0,-25080],[0,65536,0],[25080,0,60548]
